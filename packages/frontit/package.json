{
  "name": "frontit",
  "version": "0.2.0",
  "description": "A lightweight frontend toolkit for the web.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@frontit/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restarea92/frontit.git",
    "directory": "packages/frontit"
  },
  "homepage": "https://github.com/restarea92/frontit#readme",
  "bugs": {
    "url": "https://github.com/restarea92/frontit/issues"
  },
  "keywords": [
    "frontend",
    "browser",
    "toolkit",
    "typescript"
  ],
  "author": "restarea92 <restarea@me.com>",
  "license": "MIT"
}
